# Secrets and local state never belong in an image layer.
.env
.env.*
!.env.example

# Local build output and dependencies, rebuilt inside the image.
.next
node_modules

# Version control and editor state.
.git
.gitignore

# Local logs, screenshots and scratch scripts.
tmp-*

# Tests and tooling that the image never runs. The test configs go too:
# vitest.setup.ts imports from tests/, so leaving it in makes the build's
# type check fail on a module the image does not have.
tests
vitest.setup.ts
vitest.config.mts
playwright.config.ts
playwright.audit.config.ts
docker-compose.test.yml
playwright-report
test-results
